# Copie para backend/.env e preencha. Nunca faça commit do .env.

# Supabase > Project Settings > Database > Connection string > Session pooler (porta 5432).
# Não use o Transaction pooler (porta 6543): ele não suporta prepared statements do JPA/Flyway.
DATABASE_URL=jdbc:postgresql://aws-0-REGIAO.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_USERNAME=postgres.SEU_PROJECT_REF
DATABASE_PASSWORD=

PORT=8080

# No Render, defina também SPRING_PROFILES_ACTIVE=prod (localmente o perfil padrão é "local").

# Origens autorizadas, separadas por vírgula. Nunca use "*".
CORS_ALLOWED_ORIGINS=http://localhost:5173
