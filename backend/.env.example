# Copie para backend/.env e preencha. Nunca faça commit do .env.

# Supabase > Project Settings > Database > Connection string > Session pooler (porta 5432).
# Não use o Transaction pooler (porta 6543): ele não suporta prepared statements do JPA/Flyway.
DATABASE_URL=jdbc:postgresql://aws-0-REGIAO.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_USERNAME=postgres.SEU_PROJECT_REF
DATABASE_PASSWORD=

PORT=8080

# No Render, defina também SPRING_PROFILES_ACTIVE=prod (localmente o perfil padrão é "local").

# Origens autorizadas, separadas por vírgula. Nunca use "*".
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Supabase Storage (bucket "imoveis", já criado). A secret key fica só no backend:
# Supabase > Project Settings > API Keys > Secret keys. Nunca use a publishable key aqui.
SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
SUPABASE_STORAGE_BUCKET=imoveis
SUPABASE_SECRET_KEY=

# Libera upload, exclusão e foto principal. Use true somente em ambiente local:
# a API ainda não tem autenticação e essas rotas usam a secret key acima.
FOTOS_ESCRITA_HABILITADA=true

SPRING_SERVLET_MULTIPART_MAX_FILE_SIZE=5MB
SPRING_SERVLET_MULTIPART_MAX_REQUEST_SIZE=6MB

# Teto de resultados da busca dinâmica de produtos (GET /produtos/buscar). Opcional; padrão 50.
# PRODUTOS_BUSCA_LIMITE_MAXIMO=50
